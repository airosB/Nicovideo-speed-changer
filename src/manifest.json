{
  "manifest_version": 3,
  "name": "Nicovideo Speed Changer",
  "description": "ニコニコ動画を無料会員でも高速視聴できるようにする",
  "version": "0.9.0",
  "icons": {
    "128": "icon128.png",
    "48": "icon48.png",
    "16": "icon16.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.nicovideo.jp/watch/*"
      ],
      "js": ["inject.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.nicovideo.jp/watch/*"
      ],
      "js": ["main.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
